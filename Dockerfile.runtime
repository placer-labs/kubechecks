# kubechecks is built with CGO_ENABLED=0, so it needs no libc: distroless/static
# carries only ca-certificates, tzdata and /etc/passwd (no OpenSSL or glibc CVEs).
# :nonroot runs as uid 65532. Pinned by digest; bump it with the image.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

# Buildx will set TARGETARCH (amd64 / arm64)
ARG TARGETARCH

COPY kubechecks-${TARGETARCH} /usr/local/bin/kubechecks

USER nonroot:nonroot

ENTRYPOINT ["/usr/local/bin/kubechecks"]
